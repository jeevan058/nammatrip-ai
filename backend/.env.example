# Copy this file to ".env" in the same folder and fill in your values.
# NEVER commit the real .env file or share your key.

# Which LLM provider to use. "none" = deterministic demo mode (no key needed).
LLM_PROVIDER=none

# Key for the chosen provider (only needed when LLM_PROVIDER is not "none").
LLM_API_KEY=

# Model name for the chosen provider.
LLM_MODEL=

# Comma-separated list of frontend URLs allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Only for LLM_PROVIDER=openai_compatible (OpenAI, Gemini, Groq, OpenRouter...) ---
# Example for Gemini: https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=

# Seconds to wait for the AI before using the built-in fallback.
LLM_TIMEOUT_SECONDS=45
# LLM_PROVIDER can be: none | anthropic | openai_compatible
